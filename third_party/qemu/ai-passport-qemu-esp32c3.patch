+            dma_ok = esp_gdma_read_channel(s->gdma, dma_chan, data, data_bytes);
+        }
+        if (!dma_ok) {
+            memcpy(data, s->spi2_data_reg,
+                   MIN(data_bytes, sizeof(s->spi2_data_reg)));
+        }
+        if (esp32c3_spi2_trace_count < SPI2_TRACE_LIMIT) {
+            fprintf(stderr,
+                    "[ESP32-C3 SPI2 DATA] dma_ok=%d bytes=%u first=%02x%02x%02x%02x\n",
+                    dma_ok, data_bytes,
+                    data[0],
+                    data_bytes > 1 ? data[1] : 0,
+                    data_bytes > 2 ? data[2] : 0,
+                    data_bytes > 3 ? data[3] : 0);
+        }
+    }
+
+    qemu_set_irq(s->cs_gpio[0], 0);
+
+    if (has_command && command_bytes > 0 && command_bytes <= sizeof(uint32_t)) {
+        uint32_t command = s->spi2_user2 & 0xffff;
+        esp32c3_spi2_txrx_buffer(s, (const uint8_t *)&command,
+                                 command_bytes, NULL, 0);
+    }
+
+    if (has_addr && addr_bytes > 0 && addr_bytes <= sizeof(uint32_t)) {
+        uint32_t address = bswap32(s->spi2_addr);
+        address >>= 32 - addr_bytes * 8;
+        esp32c3_spi2_txrx_buffer(s, (const uint8_t *)&address,
+                                 addr_bytes, NULL, 0);
+    }
+
+    if (has_dummy) {
+        esp32c3_spi2_dummy_cycles(s, s->spi2_user1 & 0xff);
+    }
+
+    if (has_mosi || has_miso) {
+        esp32c3_spi2_txrx_buffer(s, data, has_mosi ? data_bytes : 0,
+                                 data, has_miso ? data_bytes : 0);
+        if (has_miso) {
+            if ((s->spi2_dma_conf & BIT(27)) && s->gdma &&
+                esp_gdma_get_channel_periph(s->gdma, GDMA_SPI2,
+                                             ESP_GDMA_IN_IDX, &dma_chan)) {
+                esp_gdma_write_channel(s->gdma, dma_chan, data, data_bytes);
+            } else {
+                memcpy(s->spi2_data_reg, data,
+                       MIN(data_bytes, sizeof(s->spi2_data_reg)));
+            }
+        }
+    }
+
+    qemu_set_irq(s->cs_gpio[0], 1);
+
+    s->spi2_cmd &= ~ESP32C3_SPI2_USR;
+    s->spi2_dma_int_raw |= ESP32C3_SPI2_TRANS_DONE;
+    if (dma_tx) {
+        s->spi2_dma_int_raw |= ESP32C3_SPI2_SEG_TRANS_DONE;
+    }
+    esp32c3_spi2_update_irq(s);
+    g_free(data);
+}
