+        s->registers[s->register_pointer++] = data;
+    }
+    return 0;
+}
+
+static uint8_t esp32_i2c_peripheral_recv(I2CSlave *dev)
+{
+    Esp32I2CPeripheral *s = ESP32_I2C_PERIPHERAL(dev);
+
+    esp32_i2c_device_trace(s, "R", s->registers[s->register_pointer]);
+    return s->registers[s->register_pointer++];
+}
+
+static int esp32_i2c_peripheral_event(I2CSlave *dev, enum i2c_event event)
+{
+    Esp32I2CPeripheral *s = ESP32_I2C_PERIPHERAL(dev);
+
+    if (event == I2C_START_SEND) {
+        if (esp32_i2c_device_trace_count < ESP32_I2C_DEVICE_TRACE_LIMIT) {
+            fprintf(stderr,
+                    "[ESP32-I2C DEV] addr=0x%02x START_SEND\n",
+                    s->parent_obj.address);
+            esp32_i2c_device_trace_count++;
+        }
+        s->expect_register = true;
+    }
+    return 0;
+}
+
+static void esp32_i2c_peripheral_realize(DeviceState *dev, Error **errp)
+{
+    Esp32I2CPeripheral *s = ESP32_I2C_PERIPHERAL(dev);
+
+    memset(s->registers, 0, sizeof(s->registers));
+    s->register_pointer = 0;
+    s->expect_register = true;
+
+    if (s->parent_obj.address == 0x63) {
+        /* CW2017: a stable, healthy battery is enough for the firmware to
+         * complete its optional battery initialization path. */
+        s->registers[0x00] = 0x01;
+        s->registers[0x02] = 0x2b;
+        s->registers[0x03] = 0x00;
+        s->registers[0x04] = 0x64;
+        s->registers[0x05] = 0x00;
+        s->registers[0x08] = 0x00;
+    } else if (s->parent_obj.address == 0x18) {
+        /* ES8311 identity/reset locations.  Other control registers retain
+         * their reset value and accept writes, which is sufficient for the
+         * codec driver to initialize without a physical codec. */
+        s->registers[0xfd] = 0x83;
+        s->registers[0xfe] = 0x12;
+        s->registers[0xff] = 0x10;
+    }
+}
+
+static void esp32_i2c_peripheral_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *sc = I2C_SLAVE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = esp32_i2c_peripheral_realize;
+    sc->send = esp32_i2c_peripheral_send;
+    sc->recv = esp32_i2c_peripheral_recv;
+    sc->event = esp32_i2c_peripheral_event;
+}
+
+static const TypeInfo esp32_i2c_peripheral_info = {
+    .name = TYPE_ESP32_I2C_PERIPHERAL,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(Esp32I2CPeripheral),
+    .class_init = esp32_i2c_peripheral_class_init,
+};
+
+static void esp32_i2c_peripheral_register_types(void)
+{
+    type_register_static(&esp32_i2c_peripheral_info);
+}
+
+type_init(esp32_i2c_peripheral_register_types)
