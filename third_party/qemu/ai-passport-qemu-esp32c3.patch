+static unsigned esp32c3_ble_trace_count;
+static unsigned esp32c3_radio_fe_probe_count;
+static uint32_t esp32c3_rtc_i2c_regs[0x100 / sizeof(uint32_t)];
+static uint8_t esp32c3_rtc_i2c_analog[0x100][0x100];
+static uint32_t esp32c3_assist_debug_regs[0x100 / sizeof(uint32_t)];
+
+/* I2S0 is part of the C3 APB window rather than a QEMU device in this
+ * machine.  Model the register handshakes needed by the real ESP-IDF I2S
+ * driver and let GDMA perform the actual descriptor transaction. */
+#define ESP32C3_I2S_REG_COUNT (0x100 / sizeof(uint32_t))
+#define ESP32C3_I2S0_BASE     0x6002d000
+#define ESP32C3_I2S_INT_RAW   0x00c
+#define ESP32C3_I2S_INT_ST    0x010
+#define ESP32C3_I2S_INT_ENA   0x014
+#define ESP32C3_I2S_INT_CLR   0x018
+#define ESP32C3_I2S_RX_CONF   0x020
+#define ESP32C3_I2S_TX_CONF   0x024
+#define ESP32C3_I2S_STATE     0x06c
+#define ESP32C3_I2S_UPDATE    BIT(8)
+#define ESP32C3_I2S_RX_START  BIT(2)
+#define ESP32C3_I2S_TX_START  BIT(2)
+#define ESP32C3_I2S_RX_DONE   BIT(0)
+#define ESP32C3_I2S_TX_DONE   BIT(1)
+#define ESP32C3_I2S_DMA_POLL_MS 15
+static uint32_t esp32c3_i2s_regs[ESP32C3_I2S_REG_COUNT];
+static ESPGdmaState *esp32c3_i2s_gdma;
+static QEMUTimer *esp32c3_i2s_dma_timer;
+static bool esp32c3_i2s_tx_active;
+static bool esp32c3_i2s_rx_active;
+static unsigned esp32c3_i2s_dma_tick_count;
+
+/*
+ * The physical board's ES8311 receives the bytes written to I2S TX.  The
+ * simulator has no physical codec, so expose those exact DMA bytes on the
+ * machine stdout JSON-lines transport.  The Web layer can then play the
+ * firmware's PCM without inventing a tone or changing the firmware program.
+ *
+ * The current AI Passport BSP opens the codec as 16 kHz, 16-bit mono PCM.
+ * The payload is still the unmodified guest DMA buffer; these fields describe
+ * the format used by the supported BSP audio path.
+ */
+#define ESP32C3_AUDIO_SAMPLE_RATE 16000
+#define ESP32C3_AUDIO_CHANNELS 1
+
+static void esp32c3_emit_audio(const uint8_t *pcm, size_t bytes)
+{
+    if (!pcm || bytes == 0 || (bytes & 1)) {
+        return;
+    }
+    g_autofree gchar *encoded = g_base64_encode(pcm, bytes);
+    g_print("{\"type\":\"audio\",\"dir\":\"play\","
+            "\"format\":\"pcm-s16le\",\"rate\":%u,"
+            "\"channels\":%u,\"samples\":\"%s\"}\n",
+            ESP32C3_AUDIO_SAMPLE_RATE, ESP32C3_AUDIO_CHANNELS, encoded);
+    fflush(stdout);
+}
+
+static void esp32c3_i2s_trace(const char *op, hwaddr offset,
+                              uint32_t value)
+{
+    if (esp32c3_i2s_trace_count >= ESP32C3_I2S_TRACE_LIMIT) {
+        return;
+    }
+    vaddr pc = current_cpu && current_cpu->cc->get_pc
+        ? current_cpu->cc->get_pc(current_cpu) : 0;
+    fprintf(stderr,
+            "[ESP32-C3 I2S TRACE] %s pc=0x%08llx off=0x%03llx value=0x%08x\\n",
+            op, (unsigned long long)pc, (unsigned long long)offset, value);
+    esp32c3_i2s_trace_count++;
+}
+
+static uint32_t esp32c3_i2s_status(void)
+{
+    return esp32c3_i2s_regs[ESP32C3_I2S_INT_RAW >> 2] &
+           esp32c3_i2s_regs[ESP32C3_I2S_INT_ENA >> 2];
+}
+
+static void esp32c3_i2s_complete_dma(bool tx)
+{
+    static uint8_t tx_sink[4096];
+    static uint8_t rx_source[4096];
+    uint32_t chan = 0;
+    uint32_t transferred = 0;
+    bool ok = false;
+    bool found = false;
+
+    if (esp32c3_i2s_gdma &&
+        esp_gdma_get_channel_periph(esp32c3_i2s_gdma, GDMA_I2S0,
+                                    tx ? ESP_GDMA_OUT_IDX : ESP_GDMA_IN_IDX,
+                                    &chan)) {
+        found = true;
+        const uint32_t raw = esp_gdma_read_chan_register(
+            esp32c3_i2s_gdma,
+            tx ? ESP_GDMA_OUT_IDX : ESP_GDMA_IN_IDX,
+            chan, GDMA_INT_RAW_REG);
+        const uint32_t status = esp_gdma_read_chan_register(
+            esp32c3_i2s_gdma,
+            tx ? ESP_GDMA_OUT_IDX : ESP_GDMA_IN_IDX,
+            chan, GDMA_INT_ST_REG);
+        const uint32_t ena = esp_gdma_read_chan_register(
+            esp32c3_i2s_gdma,
+            tx ? ESP_GDMA_OUT_IDX : ESP_GDMA_IN_IDX,
+            chan, GDMA_INT_ENA_REG);
+        const uint32_t completion_mask = tx
+            ? (R_GDMA_INTERRUPT_OUT_DONE_MASK |
+               R_GDMA_INTERRUPT_OUT_EOF_MASK |
+               R_GDMA_INTERRUPT_OUT_TOTAL_EOF_MASK)
+            : (R_GDMA_INTERRUPT_IN_DONE_MASK |
+               R_GDMA_INTERRUPT_IN_SUC_EOF_MASK);
+
+        /* GDMA completion is the interrupt source used by the IDF I2S
+         * driver.  Do not enqueue another descriptor while the previous
+         * completion is still pending; doing so turns a host timer into an
+         * interrupt storm and can starve the guest's input task. */
+        fprintf(stderr,
+                "[ESP32-C3 I2S DMA STATE] dir=%s chan=%u raw=0x%08x st=0x%08x ena=0x%08x mask=0x%08x desc=0x%08x eof=0x%08x\n",
+                tx ? "TX" : "RX", chan, raw, status, ena, completion_mask,
+                (uint32_t)esp_gdma_read_chan_register(
+                    esp32c3_i2s_gdma,
+                    tx ? ESP_GDMA_OUT_IDX : ESP_GDMA_IN_IDX,
+                    chan, GDMA_DESC_ADDR_REG),
+                (uint32_t)esp_gdma_read_chan_register(
+                    esp32c3_i2s_gdma,
+                    tx ? ESP_GDMA_OUT_IDX : ESP_GDMA_IN_IDX,
+                    chan, GDMA_SUC_EOF_DESC_REG));
+        if (status & completion_mask) {
+            return;
+        }
+        /* I2S raises OUT EOF at descriptor boundaries.  Service exactly one
+         * guest-owned descriptor so the real IDF ISR can observe its EOF
+         * address and recycle/refill the ring before the next transaction. */
+        ok = tx
+            ? esp_gdma_read_channel_one(esp32c3_i2s_gdma, chan, tx_sink,
+                                        sizeof(tx_sink), &transferred)
+            : esp_gdma_write_channel_one(esp32c3_i2s_gdma, chan, rx_source,
+                                         sizeof(rx_source));
+        if (tx && ok) {
+            /* Forward exactly the descriptor bytes consumed from guest RAM;
+             * the first descriptor can be 960 bytes while subsequent ring
+             * nodes are commonly 480 bytes. */
+            esp32c3_emit_audio(tx_sink, transferred);
+        }
+    }
+
+    fprintf(stderr,
+            "[ESP32-C3 I2S DMA] dir=%s found=%d chan=%u ok=%d\n",
+            tx ? "TX" : "RX", found, chan, ok);
+
+    esp32c3_i2s_regs[ESP32C3_I2S_INT_RAW >> 2] |=
+        tx ? ESP32C3_I2S_TX_DONE : ESP32C3_I2S_RX_DONE;
+    esp32c3_i2s_trace(tx ? "TX_DONE" : "RX_DONE", 0,
+                      (ok ? 0x80000000u : 0) |
+                      esp32c3_i2s_regs[ESP32C3_I2S_INT_RAW >> 2]);
+}
+
+static void esp32c3_i2s_dma_tick(void *opaque)
+{
+    (void)opaque;
+
+    if (esp32c3_i2s_dma_tick_count < 32) {
+        fprintf(stderr,
+                "[ESP32-C3 I2S DMA TICK] count=%u tx=%d rx=%d now=%llu\n",
+                esp32c3_i2s_dma_tick_count,
+                esp32c3_i2s_tx_active,
+                esp32c3_i2s_rx_active,
+                (unsigned long long)qemu_clock_get_ns(QEMU_CLOCK_REALTIME));
+        esp32c3_i2s_dma_tick_count++;
+    }
+
+    /* The real I2S engine advances one linked-list node while the previous
+     * completion interrupt is being serviced.  Use the host clock to model
+     * that asynchronous engine.  This firmware routes completion through the
+     * GDMA interrupt rather than I2S INT_RAW; the GDMA transfer path clears
+     * its own completion state when the next node starts. */
+    if (esp32c3_i2s_tx_active) {
+        esp32c3_i2s_complete_dma(true);
+    }
+    if (esp32c3_i2s_rx_active) {
+        esp32c3_i2s_complete_dma(false);
+    }
+
+    if (esp32c3_i2s_tx_active || esp32c3_i2s_rx_active) {
+        timer_mod_ns(esp32c3_i2s_dma_timer,
+                     qemu_clock_get_ns(QEMU_CLOCK_REALTIME) +
+                     ESP32C3_I2S_DMA_POLL_MS * SCALE_MS);
+    }
+}
+
+static uint32_t esp32c3_i2s_read(hwaddr offset)
+{
+    uint32_t value = 0;
+    switch (offset) {
+    case ESP32C3_I2S_INT_ST:
+        value = esp32c3_i2s_status();
+        break;
+    case ESP32C3_I2S_STATE:
+        value = BIT(0);
+        break;
+    default:
+        value = esp32c3_i2s_regs[offset >> 2];
+        break;
+    }
+    esp32c3_i2s_trace("R", offset, value);
+    return value;
+}
+
+static void esp32c3_i2s_write(hwaddr offset, uint32_t value)
+{
+    esp32c3_i2s_trace("W", offset, value);
+    switch (offset) {
+    case ESP32C3_I2S_INT_RAW:
+        /* Read-only on the C3; retain the hardware-produced status. */
+        break;
+    case ESP32C3_I2S_INT_CLR:
+        esp32c3_i2s_regs[ESP32C3_I2S_INT_RAW >> 2] &= ~value;
+        break;
+    case ESP32C3_I2S_INT_ENA:
+        esp32c3_i2s_regs[offset >> 2] = value;
+        break;
+    case ESP32C3_I2S_RX_CONF:
+        /* RX_UPDATE is a self-clearing APB-to-I2S clock-domain handshake. */
+        esp32c3_i2s_regs[offset >> 2] = value &
+            ~(ESP32C3_I2S_RX_START | ESP32C3_I2S_UPDATE);
+        if (value & ESP32C3_I2S_RX_START) {
+            esp32c3_i2s_rx_active = true;
+            esp32c3_i2s_complete_dma(false);
+            timer_mod_ns(esp32c3_i2s_dma_timer,
+                         qemu_clock_get_ns(QEMU_CLOCK_REALTIME) +
+                         ESP32C3_I2S_DMA_POLL_MS * SCALE_MS);
+        }
+        break;
+    case ESP32C3_I2S_TX_CONF:
+        /* TX_UPDATE is a self-clearing APB-to-I2S clock-domain handshake. */
+        esp32c3_i2s_regs[offset >> 2] = value &
+            ~(ESP32C3_I2S_TX_START | ESP32C3_I2S_UPDATE);
+        if (value & ESP32C3_I2S_TX_START) {
+            esp32c3_i2s_tx_active = true;
+            esp32c3_i2s_complete_dma(true);
+            timer_mod_ns(esp32c3_i2s_dma_timer,
+                         qemu_clock_get_ns(QEMU_CLOCK_REALTIME) +
+                         ESP32C3_I2S_DMA_POLL_MS * SCALE_MS);
+        }
+        break;
+    default:
+        esp32c3_i2s_regs[offset >> 2] = value;
+        break;
+    }
+}
+/*
+ * The ESP32-C3 BLE controller uses a private register window which is not
+ * described by the public C3 register header.  The controller bootstrap
+ * writes configuration/status words there and immediately reads them back.
+ * Returning zero for every read makes the real controller binary lose its
+ * state machine and eventually assert in emi.c.  Keep the window as ordinary
+ * deterministic MMIO storage until a more complete BTDM model is needed.
+ */
+static uint32_t esp32c3_ble_regs[ESP32C3_BLE_REG_COUNT];
+/*
+ * The ROM/BT controller uses 0x6003101c as a command/status register during
+ * BLE bring-up.  A plain read-after-write register is not sufficient here:
+ * the guest writes bit 31 as a busy command and then polls until hardware
+ * clears it.  Keep the observed command value for one poll, then complete
+ * the transaction by clearing only the observed busy bit.  This is a small
+ * transaction model derived from the real guest trace, not a synthetic BLE
+ * application state machine.
+ */
+#define ESP32C3_BLE_CMD_STATUS_REG 0x6003101c
+#define ESP32C3_BLE_BASE_STATUS_REG 0x60031000
+#define ESP32C3_BLE_SYS_STATUS_REG 0x60031004
+#define ESP32C3_BLE_SYS_STATUS_READY 0x09001b00
+static unsigned esp32c3_ble_cmd_status_polls;
+
+/* The ESP32-C3 RF frontend exposes a power-up/status bit at FE+0x174.
+ * The ROM/PHY bring-up code waits for this bit before it polls the
+ * controller status window at 0x6001c08c.  A real chip asserts it once the
+ * RF clock domain is powered; the QEMU model has no analog power domain, so
+ * model the completed digital state explicitly. */
+#define ESP32C3_RADIO_FE_READY BIT(16)
+
+/* The ESP32-C3 ROM/clock code uses otherwise undocumented state bits in the
+ * RTC-I2C command window while waiting for the internal analog-I2C sequencer.
+ * The boot ROM polls bit 24 of the command word as its completion indication;
+ * without this bit the ROM remains in a tight loop before app_main(). */
+#define ESP32C3_RTC_I2C_CMD6_OFFSET 0x050
+#define ESP32C3_RTC_I2C_MAIN_STATE_DONE (7u << 24)
+#define ESP32C3_RTC_I2C_CMD_FIRST_OFFSET 0x038
+#define ESP32C3_RTC_I2C_CMD_LAST_OFFSET  0x074
+
+#define ESP32C3_ASSIST_DEBUG_WINDOW_SIZE 0x100
+
+static uint32_t esp32c3_rtc_i2c_read_reg(hwaddr offset)
+{
+    uint32_t value = esp32c3_rtc_i2c_regs[offset >> 2];
+    return value;
+}
