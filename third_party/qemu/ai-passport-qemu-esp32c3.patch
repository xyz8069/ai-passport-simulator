diff --git a/hw/display/st7789.c b/hw/display/st7789.c
new file mode 100644
index 0000000..e2507ba
--- /dev/null
+++ b/hw/display/st7789.c
@@ -0,0 +1,239 @@
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "hw/display/st7789.h"
+
+/* Temporary bounded diagnostics for firmware display bring-up. */
+#define ST7789_TRACE_LIMIT 64
+#define ST7789_FRAME_INTERVAL_MS 33
+static unsigned st7789_trace_count;
+
+static void st7789_trace(const char *op, const ST7789State *s, uint8_t value)
+{
+    if (st7789_trace_count >= ST7789_TRACE_LIMIT) {
+        return;
+    }
+    fprintf(stderr,
+            "[ST7789 TRACE] %s dc=%d cmd=0x%02x value=0x%02x x=%u y=%u pixels=%u\\n",
+            op, s->dc_level, s->current_command, value,
+            s->current_x, s->current_y, s->pixel_count);
+    st7789_trace_count++;
+}
+
+static void st7789_dc_set(void *opaque, int n, int level)
+{
+    ST7789State *s = ST7789(opaque);
+
+    if (n == 0) {
+        s->dc_level = !!level;
+        st7789_trace("DC", s, (uint8_t)s->dc_level);
+    }
+}
+
+static void st7789_set_window(ST7789State *s, bool column)
+{
+    const uint16_t start = ((uint16_t)s->command_data[0] << 8) |
+                           s->command_data[1];
+    const uint16_t end = ((uint16_t)s->command_data[2] << 8) |
+                         s->command_data[3];
+
+    if (column) {
+        s->column_start = MIN(start, ST7789_WIDTH - 1);
+        s->column_end = MIN(end, ST7789_WIDTH - 1);
+        s->current_x = s->column_start;
+    } else {
+        s->row_start = MIN(start, ST7789_HEIGHT - 1);
+        s->row_end = MIN(end, ST7789_HEIGHT - 1);
+        s->current_y = s->row_start;
+    }
+    s->window_pixel_count = 0;
+    s->window_complete = false;
+}
+
+static void st7789_write_pixel(ST7789State *s, uint8_t low)
+{
+    const size_t offset = ((size_t)s->current_y * ST7789_WIDTH + s->current_x) * 2;
+
+    if (offset + 1 < sizeof(s->framebuffer)) {
+        /* The panel receives RGB565 most-significant byte first.  The Web
+         * canvas consumes the captured framebuffer as little-endian RGB565. */
+        s->framebuffer[offset] = low;
+        s->framebuffer[offset + 1] = s->pending_pixel;
+        s->pixel_count++;
+        s->window_pixel_count++;
+        if (s->window_pixel_count >=
+            (uint32_t)(s->column_end - s->column_start + 1) *
+            (uint32_t)(s->row_end - s->row_start + 1)) {
+            s->window_complete = true;
+        }
+    }
+
+    if (s->current_x < s->column_end) {
+        s->current_x++;
+    } else {
+        s->current_x = s->column_start;
+        if (s->current_y < s->row_end) {
+            s->current_y++;
+        } else {
+            s->current_y = s->row_start;
+        }
+    }
+}
+
+static uint32_t st7789_transfer(SSIPeripheral *dev, uint32_t value)
+{
+    ST7789State *s = ST7789(dev);
+    const uint8_t byte = value & 0xff;
+
+    if (!s->dc_level) {
+        s->current_command = byte;
+        s->command_data_len = 0;
+        s->pending_pixel_high = false;
+        s->ramwr_active = byte == 0x2c;
+        if (s->ramwr_active) {
+            s->window_pixel_count = 0;
+            s->window_complete = false;
+        }
+        st7789_trace("CMD", s, byte);
+        switch (byte) {
+        case 0x29:
+            s->display_on = true;
+            break;
+        case 0x20:
+            s->invert_color = false;
+            break;
+        case 0x21:
+            s->invert_color = true;
+            break;
+        default:
+            break;
+        }
+        return 0;
+    }
+
+    if (s->ramwr_active) {
+        if (s->pixel_count < 4) {
+            st7789_trace("PIX", s, byte);
+        }
+        if (!s->pending_pixel_high) {
+            s->pending_pixel = byte;
+            s->pending_pixel_high = true;
+        } else {
+            st7789_write_pixel(s, byte);
+            s->pending_pixel_high = false;
+        }
+        return 0;
+    }
+
+    if (s->command_data_len < sizeof(s->command_data)) {
+        s->command_data[s->command_data_len++] = byte;
+        st7789_trace("PARAM", s, byte);
+    }
+
+    if (s->command_data_len == 4) {
+        switch (s->current_command) {
+        case 0x2a:
+            st7789_set_window(s, true);
+            break;
+        case 0x2b:
+            st7789_set_window(s, false);
+            break;
+        default:
+            break;
+        }
+    }
+
+    return 0;
+}
+
+static bool st7789_emit_frame(ST7789State *s)
+{
+    if (s->emitted_frame_valid &&
+        memcmp(s->emitted_framebuffer, s->framebuffer, sizeof(s->framebuffer)) == 0) {
+        return false;
+    }
+
+    memcpy(s->emitted_framebuffer, s->framebuffer, sizeof(s->framebuffer));
+    s->emitted_frame_valid = true;
+    s->frame_revision++;
+    g_autofree gchar *encoded = g_base64_encode(s->framebuffer,
+                                                sizeof(s->framebuffer));
+
+    g_print("{\"type\":\"frame\",\"width\":%u,\"height\":%u,"
+            "\"format\":\"rgb565-le\",\"frame_revision\":%" PRIu64 ","
+            "\"frame_rgb565_b64\":\"%s\"}\n",
+            ST7789_WIDTH, ST7789_HEIGHT, s->frame_revision, encoded);
+    fflush(stdout);
+    /* Frame forwarding is a host-side transport throttle.  The guest may
+     * spend a long time in a DMA/driver polling loop without advancing
+     * QEMU's virtual clock, so use host time here. */
+    s->last_frame_ms = qemu_clock_get_ms(QEMU_CLOCK_HOST);
+    return true;
+}
+
+static int st7789_set_cs(SSIPeripheral *dev, bool level)
+{
+    ST7789State *s = ST7789(dev);
+
+    st7789_trace(level ? "CS_HIGH" : "CS_LOW", s, (uint8_t)level);
+
+    if (level && s->pixel_count > 0) {
+        const int64_t now = qemu_clock_get_ms(QEMU_CLOCK_HOST);
+
+        /* LVGL flushes row-sized DMA buffers.  Keep every SPI write in the
+         * real panel framebuffer, but only serialize its complete state at a
+         * display-like cadence so stdout cannot stall the guest. */
+        if (s->last_frame_ms < 0 ||
+            now - s->last_frame_ms >= ST7789_FRAME_INTERVAL_MS) {
+            st7789_emit_frame(s);
+            s->window_complete = false;
+        }
+        s->pixel_count = 0;
+    }
+    return 0;
+}
+
+static void st7789_realize(SSIPeripheral *dev, Error **errp)
+{
+    ST7789State *s = ST7789(dev);
+
+    s->column_end = ST7789_WIDTH - 1;
+    s->row_end = ST7789_HEIGHT - 1;
+    s->colmod = 0x55;
+    qdev_init_gpio_in_named(DEVICE(s), st7789_dc_set, "dc", 1);
+}
+
+static void st7789_init(Object *obj)
+{
+    ST7789State *s = ST7789(obj);
+
+    memset(s->framebuffer, 0, sizeof(s->framebuffer));
+    memset(s->emitted_framebuffer, 0, sizeof(s->emitted_framebuffer));
+    s->dc_level = true;
+    s->last_frame_ms = -1;
+}
+
+static void st7789_class_init(ObjectClass *klass, void *data)
+{
+    SSIPeripheralClass *sc = SSI_PERIPHERAL_CLASS(klass);
+
+    sc->realize = st7789_realize;
+    sc->transfer = st7789_transfer;
+    sc->set_cs = st7789_set_cs;
+    sc->cs_polarity = SSI_CS_LOW;
+}
+
+static const TypeInfo st7789_info = {
+    .name = TYPE_ST7789,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(ST7789State),
+    .instance_init = st7789_init,
+    .class_init = st7789_class_init,
+};
+
+static void st7789_register_types(void)
+{
+    type_register_static(&st7789_info);
+}
+
+type_init(st7789_register_types)
