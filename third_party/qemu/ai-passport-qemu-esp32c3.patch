+static void esp32c3_spi2_write(void *opaque, hwaddr addr,
+                                uint64_t value, unsigned int size)
+{
+    ESP32C3SpiState *s = ESP32C3_SPI(opaque);
+    const uint32_t wvalue = value;
+
+    if (esp32c3_spi2_trace_count < SPI2_TRACE_LIMIT) {
+        vaddr pc = current_cpu && current_cpu->cc->get_pc
+            ? current_cpu->cc->get_pc(current_cpu) : 0;
+        fprintf(stderr,
+                "[ESP32-C3 SPI2 TRACE] W pc=0x%08llx off=0x%03llx size=%u value=0x%08x\n",
+                (unsigned long long)pc, (unsigned long long)addr, size,
+                wvalue);
+        esp32c3_spi2_trace_count++;
+    }
+
+    switch (addr) {
+    case ESP32C3_SPI2_CMD:
+        s->spi2_cmd = wvalue;
+        if (wvalue & ESP32C3_SPI2_UPDATE) {
+            /* The real GPSPI2 synchronizes the APB-side configuration into
+             * the SPI clock domain and clears UPDATE when that completes.
+             * ESP-IDF immediately polls this bit after every configuration
+             * change, so the emulation must complete the handshake here. */
+            s->spi2_cmd &= ~ESP32C3_SPI2_UPDATE;
+        }
+        if (wvalue & ESP32C3_SPI2_SOFT_RESET) {
+            s->spi2_cmd &= ~ESP32C3_SPI2_SOFT_RESET;
+            s->spi2_dma_int_raw = 0;
+        }
+        if (wvalue & ESP32C3_SPI2_USR) {
+            esp32c3_spi2_begin_transaction(s);
+        }
+        break;
+    case ESP32C3_SPI2_ADDR:
+        s->spi2_addr = wvalue;
+        break;
+    case ESP32C3_SPI2_CTRL:
+        s->spi2_ctrl = wvalue;
+        break;
+    case ESP32C3_SPI2_CLOCK:
+        s->spi2_clock = wvalue;
+        break;
+    case ESP32C3_SPI2_USER:
+        s->spi2_user = wvalue;
+        break;
+    case ESP32C3_SPI2_USER1:
+        s->spi2_user1 = wvalue;
+        break;
+    case ESP32C3_SPI2_USER2:
+        s->spi2_user2 = wvalue;
+        break;
+    case ESP32C3_SPI2_MS_DLEN:
+        s->spi2_ms_dlen = wvalue;
+        break;
+    case ESP32C3_SPI2_MISC:
+        s->spi2_misc = wvalue;
+        break;
+    case ESP32C3_SPI2_DMA_CONF:
+        s->spi2_dma_conf = wvalue;
+        break;
+    case ESP32C3_SPI2_DMA_INT_ENA:
+        s->spi2_dma_int_ena = wvalue;
+        esp32c3_spi2_update_irq(s);
+        break;
+    case ESP32C3_SPI2_DMA_INT_CLR:
+        s->spi2_dma_int_raw &= ~wvalue;
+        esp32c3_spi2_update_irq(s);
+        break;
+    case ESP32C3_SPI2_DMA_INT_RAW:
+        s->spi2_dma_int_raw = wvalue;
+        esp32c3_spi2_update_irq(s);
+        break;
+    case ESP32C3_SPI2_W0 ... ESP32C3_SPI2_W15:
+        s->spi2_data_reg[(addr - ESP32C3_SPI2_W0) / sizeof(uint32_t)] = wvalue;
+        break;
+    default:
+        break;
+    }
+}
