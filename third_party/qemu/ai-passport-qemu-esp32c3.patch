+static uint64_t esp32c3_spi2_read(void *opaque, hwaddr addr,
+                                   unsigned int size)
+{
+    ESP32C3SpiState *s = ESP32C3_SPI(opaque);
+
+    switch (addr) {
+    case ESP32C3_SPI2_CMD:
+        return s->spi2_cmd;
+    case ESP32C3_SPI2_ADDR:
+        return s->spi2_addr;
+    case ESP32C3_SPI2_CTRL:
+        return s->spi2_ctrl;
+    case ESP32C3_SPI2_CLOCK:
+        return s->spi2_clock;
+    case ESP32C3_SPI2_USER:
+        return s->spi2_user;
+    case ESP32C3_SPI2_USER1:
+        return s->spi2_user1;
+    case ESP32C3_SPI2_USER2:
+        return s->spi2_user2;
+    case ESP32C3_SPI2_MS_DLEN:
+        return s->spi2_ms_dlen;
+    case ESP32C3_SPI2_MISC:
+        return s->spi2_misc;
+    case ESP32C3_SPI2_DMA_CONF:
+        return s->spi2_dma_conf;
+    case ESP32C3_SPI2_DMA_INT_ENA:
+        return s->spi2_dma_int_ena;
+    case ESP32C3_SPI2_DMA_INT_CLR:
+        return 0;
+    case ESP32C3_SPI2_DMA_INT_RAW:
+        return s->spi2_dma_int_raw;
+    case ESP32C3_SPI2_DMA_INT_ST:
+        return s->spi2_dma_int_raw & s->spi2_dma_int_ena;
+    case ESP32C3_SPI2_W0 ... ESP32C3_SPI2_W15:
+        return s->spi2_data_reg[(addr - ESP32C3_SPI2_W0) / sizeof(uint32_t)];
+    default:
+        return 0;
+    }
+}
